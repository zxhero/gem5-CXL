////////////////////////////////////////////////////////////////////
//
// Asynchronous Memory operation instructions
//

def template MACFGWrConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;

        // overwrite default flags
        flags[IsMemRef] = true;
        flags[IsLoad] = false;
        flags[IsStore] = true;
        flags[IsAtomic] = true;
    }
}};


def template MACFGRdConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;
    }
}};

def template MACFGDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override {
            return NoFault;
        }
    };
}};

def template MACFGRdExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;

        RegVal data, olddata;
        if (MACFGData.find(cfgreg) != MACFGData.end()) {
            olddata = xc->readMiscReg(MACFGData.at(cfgreg).physIndex);
        } else {
            std::string error = csprintf("Illegal MACFG index %#x\n", cfgreg);
            fault = make_shared<IllegalInstFault>(error, machInst);
            olddata = 0;
        }
        DPRINTF(RiscvMisc, "Reading MACFG %s: %#x\n",
                MACFGData.at(cfgreg).name, olddata);
        data = olddata;

        if (fault == NoFault) {
            %(code)s;
            if (fault == NoFault) {
                %(op_wb)s;
            }
        }
        return fault;
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

def template MACFGWrExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;

        RegVal data, olddata;
        if (MACFGData.find(cfgreg) != MACFGData.end()) {
            olddata = xc->readMiscReg(MACFGData.at(cfgreg).physIndex);
        } else {
            std::string error = csprintf("Illegal MACFG index %#x\n", cfgreg);
            fault = make_shared<IllegalInstFault>(error, machInst);
            olddata = 0;
        }
        DPRINTF(RiscvMisc, "Reading MACFG %s: %#x\n",
                MACFGData.at(cfgreg).name, olddata);
        data = olddata;

        if (fault == NoFault) {
            %(code)s;
            if (fault == NoFault) {
                if (data != olddata) {
                    DPRINTF(RiscvMisc, "Writing %#x to MACFG %s.\n", data,
                            MACFGData.at(cfgreg).name);
                    switch (cfgreg) {
                      case MACFG_QBASE:
                      case MACFG_QLENGTH:
                        xc->setMiscReg(MACFGData.at(cfgreg).physIndex, data);
                        fault = writeMemTimingLE(xc, traceData, data,
                            0x1000000000000000 + cfgreg,
                            Request::ASYNCMEM_CFGREG | Request::UNCACHEABLE,
                            nullptr);
                        break;
                      default:
                        xc->setMiscReg(MACFGData.at(cfgreg).physIndex, data);
                    }
                }
            }
            if (fault == NoFault) {
                %(op_wb)s;
            }
        }
        return fault;
    }
}};


def template ALoadStoreDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;
    };
}};


def template ALoadStoreConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;
        %(offset_code)s;

        // overwrite default flags
        flags[IsMemRef] = true;
        flags[IsLoad] = false;
        flags[IsStore] = true;
        flags[IsAtomic] = true;
    }
}};

let {{
def ALoadStoreBase(name, Name, offset_code, ea_code, memacc_code,
        memacc_code2, mem_flags,
        inst_flags, base_class, postacc_code='', decode_template=BasicDecode,
        exec_template_base=''):
    # Make sure flags are in lists (convert to lists if not).
    mem_flags = makeList(mem_flags)
    inst_flags = makeList(inst_flags)

    iop = InstObjParams(name, Name, base_class,
        {'offset_code': offset_code, 'ea_code': ea_code,
         'memacc_code': memacc_code, 'memacc_code2': memacc_code2,
         'postacc_code': postacc_code },
        inst_flags)

    if mem_flags:
        mem_flags = [ 'Request::%s' % flag for flag in mem_flags ]
        s = '\n\tmemAccessFlags = ' + '|'.join(mem_flags) + ';'
        iop.constructor += s

    # select templates

    fullExecTemplate = eval(exec_template_base + 'Execute')
    initiateAccTemplate = eval(exec_template_base + 'InitiateAcc')
    completeAccTemplate = eval(exec_template_base + 'CompleteAcc')

    # (header_output, decoder_output, decode_block, exec_output)
    return (ALoadStoreDeclare.subst(iop),
        ALoadStoreConstructor.subst(iop),
        decode_template.subst(iop),
        fullExecTemplate.subst(iop) +
        initiateAccTemplate.subst(iop) +
        completeAccTemplate.subst(iop))
}};

def template ALoadStoreExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Addr EA;
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        if (fault == NoFault) {
            %(memacc_code)s;
        }

        if (fault == NoFault) {
            fault = writeMemAtomicLE(xc, traceData, Mem, EA, memAccessFlags,
                nullptr);
        }

        if (fault == NoFault) {
            %(postacc_code)s;
        }

        if (fault == NoFault) {
            %(op_wb)s;
        }

        return fault;
    }
}};

def template ALoadStoreInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Addr EA;
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        if (fault == NoFault) {
            %(memacc_code)s;
        }

        if (fault == NoFault) {
            uint64_t macfgreg = FUNCT7;
            uint64_t olddata =
                xc->readMiscReg(MACFGData.at(macfgreg).physIndex);
            fault = writeMemTimingLE(xc, traceData, Mem, EA,
                memAccessFlags, &olddata);
        }

        if (fault == NoFault) {
            %(op_wb)s;
        }

        return fault;
    }
}};

def template ALoadStoreCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        // int64_t rd = 0;
        // int64_t mem;
        %(op_decl)s;
        %(op_rd)s;

        getMemLE(pkt, Mem, traceData);

        if (fault == NoFault) {
            %(memacc_code2)s;
        }

        if (fault == NoFault) {
            %(op_wb)s;
            // int64_t final_val = rd;
            // xc->setIntRegOperand(this, 0, final_val);
            // if (traceData) { traceData->setData(final_val); }
        }

        return fault;
    }
}};

def format ALoad(memacc_code, memacc_code2, ea_code = {{EA = Rs2;}},
        offset_code={{;}}, mem_flags=[ASYNCMEM_ALOAD, UNCACHEABLE],
        inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        ALoadStoreBase(name, Name, offset_code, ea_code, \
        memacc_code, memacc_code2,\
        mem_flags, inst_flags, 'Store', exec_template_base='ALoadStore')
}};

def format AStore(memacc_code, memacc_code2, ea_code={{EA = Rs2;}},
        offset_code={{;}}, mem_flags=[ASYNCMEM_ASTORE, UNCACHEABLE],
        inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        ALoadStoreBase(name, Name, offset_code, ea_code, \
        memacc_code, memacc_code2,\
        mem_flags, inst_flags, 'Store', exec_template_base='ALoadStore')
}};

def format TestFin(memacc_code, memacc_code2,
        ea_code={{EA = 0x1000000000000000;}},
        offset_code={{;}}, mem_flags=[ASYNCMEM_TESTFIN, UNCACHEABLE],
        inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        ALoadStoreBase(name, Name, offset_code, ea_code, \
        memacc_code, memacc_code2,\
        mem_flags, inst_flags, 'Store', exec_template_base='ALoadStore')
}};

def format MACFGRdOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MACFGOp', {"code": code}, opt_flags)
    header_output = MACFGDeclare.subst(iop)
    decoder_output = MACFGRdConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MACFGRdExecute.subst(iop)
}};

def format MACFGWrOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MACFGOp', {"code": code}, opt_flags)
    header_output = MACFGDeclare.subst(iop)
    decoder_output = MACFGWrConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MACFGWrExecute.subst(iop)
}};
