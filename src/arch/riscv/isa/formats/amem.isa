def format MACFGRdOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MACFGOp', {"code": code}, opt_flags)
    header_output = MACFGDeclare.subst(iop)
    decoder_output = MACFGRdConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MACFGRdExecute.subst(iop)
}};

def format GetFin(code, *opt_flags) {{
    ea_code='EA=0x1000000000000000 + MACFG_GETFIN;'
    testflag_code='AMFinListEmpty == AM_STATE_EMPTY'
    exec_code='\
    for (unsigned i = 0; i < eCount; ++i) { \n\
        AMFinList_uh[i] = AMFinListMerge_uh[i]; \n\
    }'
    wbfinlist_code='\
        for (unsigned i = 0; i < eCount; ++i) { \n\
            AMFinList_uh[i] = finListRegBits[i]; \n\
        }'
    setflag_code='AMFinListEmpty = AM_STATE_LOADING;'
    iop = InstObjParams(name, Name, 'GetfinMacro',
        {"getfin_op": "Ld", "ea_code": ea_code,
        "exec_code": exec_code,
        "testflag_code": testflag_code,
        "setflag_code": setflag_code,
        "wbfinlist_code": wbfinlist_code}, opt_flags)
    header_output = GetfinMacroDeclare.subst(iop)
    header_output += GetFinMicroDeclare.subst(iop)
    decoder_output = GetFinConstructor.subst(iop)
    decoder_output += GetfinLdMicroConstructor.subst(iop)
    exec_output = GetfinLdMicroExecute.subst(iop)

    decode_block = GetfinDecode.subst(iop)
    exec_code='\
    for (unsigned i = 0; i < eCount; ++i) { \n\
        AMFinList_uh[i] = AMFinListMerge_uh[i]; \n\
        AMFreeListBack_uh[i] = AMFreeListBackMerge_uh[i]; \n\
    } \n\
    if (AMFinListMerge_uh[0] > 0 &&\n\
        AMFreeListBackMerge_uh[0] < eCount - 1) { \n\
        int finPos = AMFinListMerge_uh[0]; \n\
        Rd = AMFinListMerge_uh[finPos]; \n\
        for (unsigned i = finPos; i < eCount; ++i) { \n\
            AMFinList_uh[i] = 0; \n\
        } \n\
        AMFinList_uh[0] = AMFinListMerge_uh[0] - 1; \n\
        int freePos = AMFreeListBackMerge_uh[0] + 1; \n\
        AMFreeListBack_uh[freePos] = Rd; \n\
        AMFreeListBack_uh[0] = AMFreeListBackMerge_uh[0] + 1;\n \
    } else { \n\
        Rd = 0; \n\
        if (AMFinListMerge_uh[0] == 0) { \n\
            AMFinListEmpty = AM_STATE_EMPTY; \n\
        } \n\
    }'

    iop = InstObjParams(name, Name, 'GetfinMacro',
        {"getfin_op": "Exec", "exec_code": exec_code}, opt_flags)
    header_output += GetFinMicroDeclare.subst(iop)
    decoder_output += GetfinExecMicroConstructor.subst(iop)
    exec_output += GetfinExecMicroExecute.subst(iop)

    ea_code='EA=0x1000000000000000 + MACFG_WRITEFREE;'
    exec_code='\
    for (unsigned i = 0; i < eCount; ++i) { \n\
        AMFreeList_uh[i] = AMFreeListMerge_uh[i]; \n\
        AMFreeListBack_uh[i] = AMFreeListBackMerge_uh[i]; \n\
    }'
    testflag_code='AMFreeListBackMerge_uh[0] == eCount - 1'
    memcpy_code=' \
        for (unsigned i = 0; i < eCount; ++i) { \n\
            membuf[i] = AMFreeListBackMerge_uh[i]; \n\
            AMFreeListBack_uh[i] = 0; \n\
        }'
    iop = InstObjParams(name, Name, 'GetfinMacro',
        {"getfin_op": "St", "ea_code": ea_code,
        "exec_code": exec_code,
        "memcpy_code": memcpy_code,
        "testflag_code": testflag_code}, opt_flags)
    header_output += GetFinMicroDeclare.subst(iop)
    decoder_output += GetfinStMicroConstructor.subst(iop)
    exec_output += GetfinStMicroExecute.subst(iop)

    # define allocFreeMicro here!
    ea_code='EA=0x1000000000000000 + MACFG_GETFREE;'
    testflag_code='freeListFinalCount == 0'
    wbfinlist_code='\
        for (unsigned i = 0; i < eCount; ++i) { \n\
            AMFreeList_uh[i] = freeListRegBits[i]; \n\
        }'
    pull_from_backreg='\
        int freeListFinalCount = AMFreeListMerge_uh[0]; \n\
        for (unsigned i = 0; i < eCount; ++i) { \n\
            AMFreeList_uh[i] = AMFreeListMerge_uh[i]; \n\
            AMFreeListBack_uh[i] = AMFreeListBackMerge_uh[i]; \n\
        } \n\
        if (AMFreeListBackMerge_uh[0] > 0) { \n\
            int pullIn = eCount - 1 - AMFreeListMerge_uh[0]; \n\
            pullIn = pullIn > AMFreeListBackMerge_uh[0] ? \n\
                AMFreeListBackMerge_uh[0] : pullIn; \n\
            if (pullIn > 0) { \n\
                int pos = AMFreeListMerge_uh[0]; \n\
                int bpos = AMFreeListBackMerge_uh[0]; \n\
                for (unsigned i = 0; i < pullIn; ++i) { \n\
                    pos = pos + 1; \n\
                    AMFreeList_uh[pos] = AMFreeListBackMerge_uh[bpos]; \n\
                    bpos = bpos - 1; \n\
                    freeListFinalCount = pos; \n\
                    AMFreeList_uh[0] = pos; \n\
                    AMFreeListBack_uh[0] = bpos; \n\
                } \n\
            } \n\
        }'
    iop = InstObjParams('allocFreeMicro', 'AllocFreeMicro',
    'ALoadStoreMicro',
        {"ea_code": ea_code,
         "testflag_code": testflag_code,
         "pull_from_backreg": pull_from_backreg,
         "wbfinlist_code": wbfinlist_code}, opt_flags)
    header_output += ALoadStoreDeclare.subst(iop)
    decoder_output += AllocFreeMicroConstructor.subst(iop)
    exec_output += AllocFreeMicroExecute.subst(iop)

    # exec_output = GetFinExecute.subst(iop)
}};

def format MACFGWrOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MACFGOp', {"code": code}, opt_flags)
    header_output = MACFGDeclare.subst(iop)
    decoder_output = MACFGWrConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MACFGWrExecute.subst(iop)
}};

def format FlushOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'Store', {"code": code}, opt_flags)
    header_output = FlushDeclare.subst(iop)
    decoder_output = FlushConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = FlushExecute.subst(iop)
}};
