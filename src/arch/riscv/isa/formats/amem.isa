        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;

        // overwrite default flags
        // flags[IsMemRef] = true;
        // flags[IsLoad] = true;
        // flags[IsStore] = false;
        // flags[IsAtomic] = true;
    }
}};

def template GetFinConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst, int decodeRng):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;

        // overwrite default flags
        // flags[IsMemRef] = true;
        // flags[IsLoad] = true;
        // flags[IsLoad] = false;
        // flags[IsStore] = true;
        // flags[IsAtomic] = false;
        // flags[IsAtomic] = true;
        flags[IsAsyncMem] = true;

        StaticInstPtr getfinLoad = new GetfinLdMicro(machInst, MemReadOp);
        StaticInstPtr getfinExec = new GetfinExecMicro(machInst, No_OpClass);
        StaticInstPtr getfinStore = new GetfinStMicro(machInst, MemWriteOp);

        getfinExec->setFlag(IsFirstMicroop);
        // getfinLoad->setFlag(IsLastMicroop);
        if (decodeRng) {
            getfinLoad->setFlag(IsLastMicroop);
            microops = {getfinExec, getfinLoad};
        } else {
            getfinStore->setFlag(IsLastMicroop);
            microops = {getfinExec, getfinStore};
        }

        // microops = {getfinLoad, getfinStore, getfinExec};
    }
}};

def template GetfinMacroDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst, int decodeRng);
    };
}};

def template AMemMacroDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);
    };
}};

def template GetFinMicroDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s%(getfin_op)sMicro : public %(class_name)sMicro
    {
      public:
        /// Constructor.
        %(class_name)s%(getfin_op)sMicro(ExtMachInst _machInst,
                                         OpClass __opClass);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;
    };
}};

def template GetfinLdMicroConstructor {{
    %(class_name)sLdMicro::%(class_name)sLdMicro(
        ExtMachInst machInst, OpClass __opClass)
            : %(class_name)sMicro("%(class_name)sLd", machInst, __opClass)
    {
        %(constructor)s;

        flags[IsMemRef] = true;
        flags[IsLoad] = true;
        flags[IsStore] = false;
        flags[IsAsyncMem] = true;
        flags[IsAMGetFin] = true;
    }
}};

def template GetfinStMicroConstructor {{
    %(class_name)sStMicro::%(class_name)sStMicro(
        ExtMachInst machInst, OpClass __opClass)
            : %(class_name)sMicro("%(class_name)sSt", machInst, __opClass)
    {
        %(constructor)s;

        flags[IsMemRef] = true;
        flags[IsLoad] = false;
        flags[IsStore] = true;
        flags[IsAsyncMem] = true;
    }
}};

def template GetfinExecMicroConstructor {{
    %(class_name)sExecMicro::%(class_name)sExecMicro(
        ExtMachInst machInst, OpClass __opClass)
            : %(class_name)sMicro("%(class_name)sExec", machInst, __opClass)
    {
        %(constructor)s;
    }
}};

def template GetfinLdMicroExecute {{
    Fault
    %(class_name)sLdMicro::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault %(class_name)sLdMicro::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        unsigned long memAccessFlags =
            Request::ASYNCMEM_CFGREG | Request::UNCACHEABLE;
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size
        Addr EA;
        // Addr EA = 0x1000000000000000 + MACFG_GETFIN;
        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(exec_code)s;
        // RegVal amState = xc->readCCRegOperand(this, 0);
        Fault fault = NoFault;
        // if (amState == AM_STATE_EMPTY) {
        if (%(testflag_code)s) {
            fault = xc->initiateMemRead(EA, accSize, memAccessFlags);
            // xc->setCCRegOperand(this, 1, AM_STATE_LOADING);
            %(setflag_code)s;
            %(op_wb)s;
        } else {
            xc->setMemAccPredicate(false);
        }

        return fault;
    }
    Fault %(class_name)sLdMicro::completeAcc(PacketPtr pkt, ExecContext *xc,
                      Trace::InstRecord *traceData) const
    {
        if (!xc->readMemAccPredicate()) return NoFault;

        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size

        %(op_decl)s;
        %(op_rd)s;

        // TheISA::VecRegContainer& tmp_finvec =
        //     xc->getWritableVecRegOperand(this, 0);
        // auto finListVec = tmp_finvec.as<uint16_t>();

        uint16_t finListRegBits[eCount];
        memcpy(finListRegBits, pkt->getPtr<uint8_t>(), pkt->getSize());

        %(wbfinlist_code)s;
        %(op_wb)s;
        // for (unsigned i = 0; i < eCount; ++i) {
        //     finListVec[i] = finListRegBits[i];
        // }

        return NoFault;
    }
}};

def template GetfinStMicroExecute {{
    Fault
    %(class_name)sStMicro::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault %(class_name)sStMicro::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        unsigned long memAccessFlags =
            Request::ASYNCMEM_CFGREG | Request::UNCACHEABLE;
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size

        Addr EA;
        // Addr EA = 0x1000000000000000 + MACFG_GETFIN;
        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(exec_code)s;

        // RegVal amState = xc->readCCRegOperand(this, 0);

        Fault fault = NoFault;
        // if (amState == AM_STATE_EMPTY) {
        if (%(testflag_code)s) {
            uint16_t membuf[eCount] = {0};
            %(memcpy_code)s;
            fault = xc->writeMem((uint8_t*)membuf, accSize,
                                EA, memAccessFlags, nullptr);
            // xc->setCCRegOperand(this, 1, AM_STATE_LOADING);
        } else {
            xc->setMemAccPredicate(false);
        }

        %(op_wb)s;

        return fault;
    }
    Fault %(class_name)sStMicro::completeAcc(PacketPtr pkt,
                      ExecContext *xc,
                      Trace::InstRecord *traceData) const
    {
        if (!xc->readMemAccPredicate()) return NoFault;

        return NoFault;
    }
}};

def template GetfinExecMicroExecute {{
    Fault
    %(class_name)sExecMicro::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size

        %(op_decl)s;
        %(op_rd)s;

        %(exec_code)s;

        %(op_wb)s;

        return NoFault;
    }
    Fault %(class_name)sExecMicro::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault %(class_name)sExecMicro::completeAcc(PacketPtr pkt, ExecContext *xc,
                      Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

// Basic decode template.
def template GetfinDecode {{
    {
        static int decodeRng = 0;
        // flip `decodeRng`
        decodeRng = 1- decodeRng;
        return new %(class_name)s(machInst, decodeRng);
    }
}};

def template AllocFreeMicroConstructor {{
    %(class_name)s::%(class_name)s(
        ExtMachInst machInst, OpClass __opClass)
            : %(base_class)s("%(mnemonic)s", machInst, __opClass)
    {
        %(constructor)s;

        flags[IsMemRef] = true;
        flags[IsLoad] = true;
        flags[IsStore] = false;
        flags[IsAMGetFree] = true;
        flags[IsAsyncMem] = true;
    }
}};

def template AllocFreeMicroExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        unsigned long memAccessFlags =
            Request::ASYNCMEM_CFGREG | Request::UNCACHEABLE;
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size
        Addr EA;
        // Addr EA = 0x1000000000000000 + MACFG_GETFIN;
        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(pull_from_backreg)s;

        // RegVal amState = xc->readCCRegOperand(this, 0);

        Fault fault = NoFault;
        // if (amState == AM_STATE_EMPTY) {
        if (%(testflag_code)s) {
            fault = xc->initiateMemRead(EA, accSize, memAccessFlags);
            // xc->setCCRegOperand(this, 1, AM_STATE_LOADING);
            %(op_wb)s;
        } else {
            xc->setMemAccPredicate(false);
        }

        return NoFault;
    }
    Fault %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
                      Trace::InstRecord *traceData) const
    {
        if (!xc->readMemAccPredicate()) return NoFault;

        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size

        %(op_decl)s;
        %(op_rd)s;

        uint16_t freeListRegBits[eCount];
        memcpy(freeListRegBits, pkt->getPtr<uint8_t>(), pkt->getSize());

        %(wbfinlist_code)s;
        %(op_wb)s;

        return NoFault;
    }
}};

def template MACFGDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;
    };
}};

def template MACFGRdExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;

        RegVal data = 0, olddata;
        if (MACFGData.find(cfgreg) != MACFGData.end()) {
            assert(cfgreg != MACFG_GETFIN);
            olddata = xc->readMiscReg(MACFGData.at(cfgreg).physIndex);
        } else {
            std::string error = csprintf("Illegal MACFG index %#x\n", cfgreg);
            fault = make_shared<IllegalInstFault>(error, machInst);
            olddata = 0;
        }
        DPRINTF(RiscvMisc, "Reading MACFG %s: %#x\n",
                MACFGData.at(cfgreg).name, olddata);
        data = olddata;

        if (fault == NoFault) {
            %(code)s;
            if (fault == NoFault) {
                %(op_wb)s;
            }
        }
        return fault;
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;
        if (cfgreg == MACFG_GETFIN) {
            %(op_decl)s;
            %(op_rd)s;
            RegVal data;
            getMemLE(pkt, data, traceData);
            if (fault == NoFault) {
                %(op_wb)s;
            }
        }
        return NoFault;
    }
}};

def template MACFGWrExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;

        RegVal data, olddata;
        if (MACFGData.find(cfgreg) != MACFGData.end()) {
            olddata = xc->readMiscReg(MACFGData.at(cfgreg).physIndex);
        } else {
            std::string error = csprintf("Illegal MACFG index %#x\n", cfgreg);
            fault = make_shared<IllegalInstFault>(error, machInst);
            olddata = 0;
        }
        DPRINTF(RiscvMisc, "Reading MACFG %s: %#x\n",
                MACFGData.at(cfgreg).name, olddata);
        data = olddata;

        if (fault == NoFault) {
            %(code)s;
            if (fault == NoFault) {
                if (data != olddata) {
                    DPRINTF(RiscvMisc, "Writing %#x to MACFG %s.\n", data,
                            MACFGData.at(cfgreg).name);
                    switch (cfgreg) {
                      case MACFG_QBASE:
                      case MACFG_QLENGTH:
                        xc->setMiscReg(MACFGData.at(cfgreg).physIndex, data);
                        fault = writeMemTimingLE(xc, traceData, data,
                            0x1000000000000000 + cfgreg,
                            Request::ASYNCMEM_CFGREG | Request::UNCACHEABLE,
                            nullptr);
                        break;
                      default:
                        xc->setMiscReg(MACFGData.at(cfgreg).physIndex, data);
                    }
                }
            }
            if (fault == NoFault) {
                %(op_wb)s;
            }
        }
        return fault;
    }
    Fault %(class_name)s::completeAcc(PacketPtr, ExecContext *,
                      Trace::InstRecord *) const {
        return NoFault;
    }
}};

def template FlushConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;

        // overwrite default flags
        flags[IsMemRef] = true;
        flags[IsLoad] = false;
        flags[IsStore] = true;
        flags[IsAtomic] = true;
    }
}};

def template FlushExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        return NoFault;
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;

        if (fault == NoFault) {
            %(code)s;
        }

        // EA = Rs1 + sext<12>(IMM12);
        if (fault == NoFault) {
            Addr op_size = xc->tcBase()->getSystemPtr()->cacheLineSize();
            EA &= ~(op_size - 1);
            fault = xc->writeMem(NULL, op_size, EA,
                Request::CLEAN | Request::INVALIDATE | Request::DST_POC,
                NULL);
        }


        return fault;
    }
    Fault %(class_name)s::completeAcc(PacketPtr, ExecContext *,
                      Trace::InstRecord *) const {
        return NoFault;
    }
}};

def template FlushDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst _machInst);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;
    };
}};

def template ALoadStoreDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst _machInst, OpClass __opClass);

        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          Trace::InstRecord *) const override;
    };
}};

def template ALoadStoreExecMicroConstructor {{
    %(class_name)s::%(class_name)s(
        ExtMachInst machInst, OpClass __opClass):
        %(base_class)s("%(mnemonic)s", machInst, __opClass)
    {
        %(constructor)s;
        %(offset_code)s;

        // overwrite default flags
        flags[IsMemRef] = true;
        flags[IsLoad] = false;
        flags[IsStore] = true;
        // flags[IsAtomic] = true;
        flags[IsAsyncMem] = true;
    }
}};

def template ALoadStoreConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst):
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(constructor)s;
        %(offset_code)s;

        // overwrite default flags
        // flags[IsMemRef] = true;
        // flags[IsLoad] = false;
        // flags[IsStore] = true;
        // flags[IsAtomic] = true;
        // flags[IsAsyncMem] = true;

        StaticInstPtr allocFreeMicro =
            new AllocFreeMicro(machInst, MemReadOp);
        StaticInstPtr execMicro =
            new %(class_name)sExecMicro(machInst, No_OpClass);

        allocFreeMicro->setFlag(IsFirstMicroop);
        execMicro->setFlag(IsLastMicroop);

        // microops = {getfinLoad, getfinStore, getfinExec};
        microops = {allocFreeMicro, execMicro};
    }
}};

let {{
def ALoadStoreBase(name, Name, offset_code, ea_code, memacc_code,
        mem_flags, inst_flags, base_class, postacc_code='',
        decode_template=BasicDecode, exec_template_base=''):
    # Make sure flags are in lists (convert to lists if not).
    mem_flags = makeList(mem_flags)
    inst_flags = makeList(inst_flags)

    iop = InstObjParams(name, Name, base_class,
        {'offset_code': offset_code, 'ea_code': ea_code,
         'postacc_code': postacc_code },
        inst_flags)

    # select templates

    fullExecTemplate = eval(exec_template_base + 'Execute')
    initiateAccTemplate = eval(exec_template_base + 'InitiateAcc')
    completeAccTemplate = eval(exec_template_base + 'CompleteAcc')

    header_output = AMemMacroDeclare.subst(iop)
    decoder_output = ALoadStoreConstructor.subst(iop)
    decode_block = decode_template.subst(iop)

    if mem_flags:
        mem_flags = [ 'Request::%s' % flag for flag in mem_flags ]
        s = '\n\tRequest::Flags memAccessFlags = ' + '|'.join(mem_flags) + ';'
    iop = InstObjParams(name+"ExecMicro", Name+"ExecMicro",
        "ALoadStoreMicro",
        {'offset_code': offset_code, 'ea_code': ea_code,
        'memacc_code': memacc_code, 'postacc_code': postacc_code,
        'memflags_def': s},
        inst_flags)

    header_output += ALoadStoreDeclare.subst(iop)
    decoder_output += ALoadStoreExecMicroConstructor.subst(iop)
    exec_output = fullExecTemplate.subst(iop) + \
        initiateAccTemplate.subst(iop) + \
        completeAccTemplate.subst(iop)

    return (header_output,
        decoder_output,
        decode_block,
        exec_output)
}};

def template ALoadStoreExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size
        Addr EA;
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(memflags_def)s;

        if (fault == NoFault) {
            %(memacc_code)s;
        }

        if (fault == NoFault) {
            fault = writeMemAtomicLE(xc, traceData, Mem,
                EA, memAccessFlags, nullptr);
        }

        if (fault == NoFault) {
            %(postacc_code)s;
        }

        if (fault == NoFault) {
            %(op_wb)s;
        }

        return fault;
    }
}};

def template ALoadStoreInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        constexpr unsigned accSize = 64; // Cache Line size
        constexpr unsigned eCount =
            accSize / sizeof(uint16_t); // Cache Line size
        Addr EA;
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(memflags_def)s;

        if (fault == NoFault) {
            %(memacc_code)s;
        }

        if (fault == NoFault && Rd != 0) {
            uint64_t macfgreg = FUNCT7;
            uint64_t olddata =
                xc->readMiscReg(MACFGData.at(macfgreg).physIndex);
            fault = writeMemTimingLE(xc, traceData, Mem, EA,
                memAccessFlags, &olddata);
        } else {
            xc->setMemAccPredicate(false);
        }

        if (fault == NoFault) {
            %(op_wb)s;
        }

        return fault;
    }
}};

def template ALoadStoreCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;

        return fault;
    }
}};

def format ALoad(memacc_code, ea_code = {{EA = Rs2;}},
        offset_code={{;}}, mem_flags=[ASYNCMEM_ALOAD, UNCACHEABLE],
        inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        ALoadStoreBase(name, Name, offset_code, ea_code, \
        memacc_code, \
        mem_flags, inst_flags, 'ALoadStoreMacro',\
        exec_template_base='ALoadStore')
}};

def format AStore(memacc_code, ea_code={{EA = Rs2;}},
        offset_code={{;}}, mem_flags=[ASYNCMEM_ASTORE, UNCACHEABLE],
        inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        ALoadStoreBase(name, Name, offset_code, ea_code, \
        memacc_code, \
        mem_flags, inst_flags, 'ALoadStoreMacro', \
        exec_template_base='ALoadStore')
}};

